{
  "name": "wasm-cel",
  "version": "0.3.0",
  "description": "WebAssembly module for evaluating CEL (Common Expression Language) expressions in Node.js and browsers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "import": "./dist/node.js"
      },
      "browser": {
        "import": "./dist/browser.js"
      },
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./main.wasm": "./main.wasm",
    "./wasm_exec": "./wasm_exec.cjs",
    "./wasm_exec.js": "./wasm_exec.cjs",
    "./wasm_exec.cjs": "./wasm_exec.cjs"
  },
  "scripts": {
    "build": "GOOS=js GOARCH=wasm go build -ldflags '-s -w' -o main.wasm ./cmd/wasm",
    "build:copy-wasm-exec": "node scripts/copy-wasm-exec.js",
    "build:ts": "tsc",
    "build:all": "pnpm run build && pnpm run build:copy-wasm-exec && pnpm run build:ts",
    "prepublishOnly": "pnpm run build:all",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": [
    "cel",
    "common-expression-language",
    "wasm",
    "webassembly",
    "expression-evaluation"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/invakid404/wasm-cel.git"
  },
  "homepage": "https://github.com/invakid404/wasm-cel#readme",
  "bugs": {
    "url": "https://github.com/invakid404/wasm-cel/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": ["dist/**/*", "main.wasm", "wasm_exec.cjs", "README.md"],
  "devDependencies": {
    "@types/node": "24.10.1",
    "jest": "30.2.0",
    "typescript": "5.9.3"
  }
}
