{
  "name": "wasm-cel",
  "version": "0.5.1",
  "description": "WebAssembly module for evaluating CEL (Common Expression Language) expressions in Node.js and browsers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "import": "./dist/node.js"
      },
      "browser": {
        "import": "./dist/browser.js"
      },
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./main.wasm": "./main.wasm",
    "./wasm_exec": "./wasm_exec.cjs",
    "./wasm_exec.js": "./wasm_exec.cjs",
    "./wasm_exec.cjs": "./wasm_exec.cjs"
  },
  "scripts": {
    "build": "GOOS=js GOARCH=wasm go build -ldflags '-s -w' -o main.wasm ./cmd/wasm && wasm-opt -Oz --all-features --strip-producers --strip-target-features main.wasm -o main.wasm",
    "build:copy-wasm-exec": "node scripts/copy-wasm-exec.js",
    "build:ts": "tsc",
    "build:all": "pnpm run build && pnpm run build:copy-wasm-exec && pnpm run build:ts",
    "prepublishOnly": "pnpm run build:all",
    "test:types": "pnpm run build:ts && tsc -p tsconfig.type-tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --browser.enabled",
    "test:browser:ui": "vitest --browser.enabled --ui"
  },
  "keywords": [
    "cel",
    "common-expression-language",
    "wasm",
    "webassembly",
    "expression-evaluation"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/invakid404/wasm-cel.git"
  },
  "homepage": "https://github.com/invakid404/wasm-cel#readme",
  "bugs": {
    "url": "https://github.com/invakid404/wasm-cel/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": ["dist/**/*", "main.wasm", "wasm_exec.cjs", "README.md"],
  "devDependencies": {
    "@types/node": "24.12.0",
    "@vitest/browser": "4.0.18",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
